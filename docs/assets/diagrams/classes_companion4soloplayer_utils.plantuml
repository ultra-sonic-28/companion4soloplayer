@startuml classes_companion4soloplayer_utils

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "C4SPSafeLoader" as companion4soloplayer.utils.yaml_loader.C4SPSafeLoader {
}
class "CharacterSaveManager" as companion4soloplayer.utils.character_save.CharacterSaveManager {
  #_slugger
  +directory : Path
  +logger : NoneType, RootLogger
  +plugin_name : str
  +save_dir
  +saves_root
  +<color:#008000>__init__(plugin_name: str, saves_root: Path | None) -> None</color>
  +<color:#008000>character_exists(slug: str) -> bool</color>
  +<color:#008000>delete_character(slug: str) -> bool</color>
  +<color:#008000>list_characters() -> list[str]</color>
  +<color:#008000>load_character(slug: str) -> Character | None</color>
  +<color:#008000>save_character(character: Character) -> Path</color>
}
class "ConfigManager" as companion4soloplayer.utils.config_manager.ConfigManager {
  +data : Table
  +filename : Path
  +<color:#008000>__init__(filename: str | Path | None) -> None</color>
  #<color:#008000>_deep_update(base: MutableMapping[str, Any], updates: Mapping[str, Any]) -> None</color>
  #<color:#008000>_preserve_invalid_file() -> None</color>
  +<color:#008000>appearance() -> Table</color>
  +<color:#008000>load() -> None</color>
  +<color:#008000>logging() -> Table</color>
  +<color:#008000>save() -> None</color>
  +<color:#008000>theme() -> str</color>
  +<color:#008000>tooltip() -> Table</color>
  +<color:#008000>tooltip_corner_type() -> TooltipCornerType</color>
  +<color:#008000>window() -> Table</color>
}
class "LogMode" as companion4soloplayer.utils.logger.LogMode {
  +name
}
class "PluginConfigRegistry" as companion4soloplayer.utils.plugin_config.PluginConfigRegistry {
  #_configs : dict[str, dict[str, Any]]
  #_initialized : ClassVar[bool]
  #_instance : Optional[ClassVar[PluginConfigRegistry | None]]
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>__new__() -> Self</color>
  +<color:#008000>character_creation_dialog_attributes_columns(plugin_name: str | None) -> int</color>
  +<color:#008000>character_creation_dialog_size(plugin_name: str | None) -> tuple[int, int]</color>
  +<color:#008000>config(plugin_name: str | None) -> dict[str, Any]</color>
  +<color:#008000>dialog_settings(dialog_name: str, plugin_name: str | None) -> dict[str, Any]</color>
  +<color:#008000>instance() -> Self</color>
  +<color:#008000>plugin_names() -> tuple[str, ...]</color>
  +<color:#008000>register(plugin_name: str, config: Mapping[str, Any] | None) -> None</color>
  +<color:#008000>reset() -> None</color>
  +<color:#008000>unregister(plugin_name: str) -> None</color>
}
class "PluginLoader" as companion4soloplayer.utils.plugin_loader.PluginLoader {
  +last_errors : dict[str, str]
  +loaded_plugins : dict[str, GamePlugin]
  +plugins_dir : Path
  +<color:#008000>__init__(plugins_dir: str | None) -> None</color>
  #<color:#008000>_find_extension(plugin_name: str, directory: Path) -> Path | None</color>
  #<color:#008000>_iter_plugin_dirs() -> list[Path]</color>
  #<color:#008000>_load_compiled(plugin_name: str, library_path: Path) -> GamePlugin | None</color>
  #<color:#008000>_load_source(plugin_name: str) -> GamePlugin | None</color>
  #<color:#008000>_publish_config(plugin_name: str, library_path: Path | None) -> None</color>
  +<color:#008000>discover_plugins() -> list[str]</color>
  +<color:#008000>get_plugin(plugin_name: str) -> GamePlugin | None</color>
  +<color:#008000>load_plugin(plugin_name: str) -> GamePlugin | None</color>
  +<color:#008000>unload_plugin(plugin_name: str) -> bool</color>
}
class "PyClassRef" as companion4soloplayer.utils.yaml_loader.PyClassRef {
  +attr : str
  +is_local : bool
  +module : str
  +params : Mapping[str, Any]
  +path : str
  +<color:#008000>__init__(self, path: str, params: Mapping[str, Any]) -> None</color>
  +<color:#008000>parse(value: str) -> PyClassRef</color>
}
class "ResourceManager" as companion4soloplayer.utils.resource_manager.ResourceManager {
  #_EXTENSIONS : dict[str, tuple[str, ...]]
  #_SUBDIRS : dict[str, str]
  #_initialized : ClassVar[bool]
  #_instance : Optional[ClassVar[ResourceManager | None]]
  #_object_cache : dict[str, object]
  #_path_cache : dict[str, Path]
  #_root : Path
  #_strict : bool
  +root : Path
  +<color:#008000>__init__(root: Path | str | None) -> None</color>
  +<color:#008000>__new__() -> Self</color>
  #<color:#008000>_detect_root(root: Path | str | None) -> Path</color>
  #<color:#008000>_validate(path: Path, category: str) -> None</color>
  +<color:#008000>clear_cache() -> None</color>
  +<color:#008000>get_data(name: str) -> Path</color>
  +<color:#008000>get_file(name: str) -> Path</color>
  +<color:#008000>get_font(name: str) -> Path</color>
  +<color:#008000>get_icon(name: str) -> Path</color>
  +<color:#008000>get_image(name: str) -> Path</color>
  +<color:#008000>get_music(name: str) -> Path</color>
  +<color:#008000>get_resource(name: str) -> Path</color>
  +<color:#008000>get_sound(name: str) -> Path</color>
  +<color:#008000>instance() -> Self</color>
  +<color:#008000>list_resources(category: str) -> list[Path]</color>
  +<color:#008000>load_icon(name: str) -> QIcon</color>
  +<color:#008000>load_pixmap(name: str) -> QPixmap</color>
  +<color:#008000>load_sound(name: str) -> QSoundEffect</color>
  +<color:#008000>reset() -> None</color>
}
class "<color:red>ResourceNotFoundError</color>" as companion4soloplayer.utils.resource_manager.ResourceNotFoundError {
}
class "SavedCharacter" as companion4soloplayer.utils.character_save.SavedCharacter {
  +character
  +plugin_name
  +saved_at
  +version
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>from_dict(data: dict[str, Any]) -> SavedCharacter</color>
  +<color:#008000>to_dict() -> dict[str, Any]</color>
}
class "Slugify" as companion4soloplayer.utils.slugify.Slugify {
  #_lowercase : bool
  #_max_length : int
  #_separator : str
  +<color:#008000>__call__(text: str) -> str</color>
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>__repr__() -> str</color>
  +<color:#008000>sanitize(text: str) -> str</color>
  +<color:#008000>unique(directory: str | os.PathLike[str], filename: str) -> str</color>
}
class "TooltipCornerType" as companion4soloplayer.utils.config_manager.TooltipCornerType {
  +name
}
class "<color:red>YamlLoadError</color>" as companion4soloplayer.utils.yaml_loader.YamlLoadError {
}
class "<color:red>YamlTagError</color>" as companion4soloplayer.utils.yaml_loader.YamlTagError {
}
class "_PluginSubmoduleFinder" as companion4soloplayer.utils.plugin_loader._PluginSubmoduleFinder {
  +package_prefixes : list[str]
  +target_module : module
  +<color:#008000>__init__(package_prefixes: list[str], target_module: types.ModuleType) -> None</color>
  +<color:#008000>create_module(spec: importlib.machinery.ModuleSpec) -> types.ModuleType | None</color>
  +<color:#FF0000>{abstract}exec_module(module: types.ModuleType) -> None</color>
  +<color:#008000>find_spec(fullname: str, path: Any, target: Any) -> importlib.machinery.ModuleSpec | None</color>
}
companion4soloplayer.utils.slugify.Slugify --* companion4soloplayer.utils.character_save.CharacterSaveManager : _slugger

' --- Force vertical alignment ---
companion4soloplayer.utils.yaml_loader.C4SPSafeLoader -[hidden]down-> companion4soloplayer.utils.character_save.CharacterSaveManager
companion4soloplayer.utils.character_save.CharacterSaveManager -[hidden]down-> companion4soloplayer.utils.config_manager.ConfigManager
companion4soloplayer.utils.config_manager.ConfigManager -[hidden]down-> companion4soloplayer.utils.logger.LogMode
companion4soloplayer.utils.logger.LogMode -[hidden]down-> companion4soloplayer.utils.plugin_config.PluginConfigRegistry
companion4soloplayer.utils.plugin_config.PluginConfigRegistry -[hidden]down-> companion4soloplayer.utils.plugin_loader.PluginLoader
companion4soloplayer.utils.plugin_loader.PluginLoader -[hidden]down-> companion4soloplayer.utils.yaml_loader.PyClassRef
companion4soloplayer.utils.yaml_loader.PyClassRef -[hidden]down-> companion4soloplayer.utils.resource_manager.ResourceManager
companion4soloplayer.utils.resource_manager.ResourceManager -[hidden]down-> companion4soloplayer.utils.resource_manager.ResourceNotFoundError
companion4soloplayer.utils.resource_manager.ResourceNotFoundError -[hidden]down-> companion4soloplayer.utils.character_save.SavedCharacter
companion4soloplayer.utils.character_save.SavedCharacter -[hidden]down-> companion4soloplayer.utils.slugify.Slugify
companion4soloplayer.utils.slugify.Slugify -[hidden]down-> companion4soloplayer.utils.config_manager.TooltipCornerType
companion4soloplayer.utils.config_manager.TooltipCornerType -[hidden]down-> companion4soloplayer.utils.yaml_loader.YamlLoadError
companion4soloplayer.utils.yaml_loader.YamlLoadError -[hidden]down-> companion4soloplayer.utils.yaml_loader.YamlTagError
companion4soloplayer.utils.yaml_loader.YamlTagError -[hidden]down-> companion4soloplayer.utils.plugin_loader._PluginSubmoduleFinder


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
