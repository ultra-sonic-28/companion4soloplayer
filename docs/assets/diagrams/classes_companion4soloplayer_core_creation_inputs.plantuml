@startuml classes_companion4soloplayer_core_creation_inputs

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "<color:red>InputError</color>" as companion4soloplayer.core.creation.inputs.InputError {
}
class "InputField" as companion4soloplayer.core.creation.inputs.InputField {
  +description : str
  +key : str
  +kind
  +label : str
  +max_count : int | None
  +max_value : int | None
  +min_count : int
  +min_value : int | None
  +option_descriptions : tuple[tuple[str, str], ...]
  +options : tuple[str, ...]
  +required : bool
  +roll : Callable[[], int] | None
  +value : int | str | None
  +<color:#008000>__init__(self, key: str, label: str, kind: InputKind, options: tuple[str, ...], required: bool, min_count: int, max_count: int | None, min_value: int | None, max_value: int | None, roll: Callable[[], int] | None, description: str, option_descriptions: tuple[tuple[str, str], ...], value: int | str | None) -> None</color>
  +<color:#008000>option_description(option: str) -> str</color>
}
class "InputKind" as companion4soloplayer.core.creation.inputs.InputKind {
  +name
}
class "InputProvider" as companion4soloplayer.core.creation.inputs.InputProvider {
  +<color:#008000>ask_choice(key: str, prompt: str, options: Sequence[Any]) -> Any</color>
  +<color:#008000>ask_many(key: str, prompt: str, options: Sequence[Any]) -> list[Any]</color>
  +<color:#008000>ask_number(key: str, prompt: str) -> int</color>
  +<color:#008000>ask_text(key: str, prompt: str) -> str</color>
}
class "<color:red>InvalidAnswerError</color>" as companion4soloplayer.core.creation.inputs.InvalidAnswerError {
}
class "MappingInputProvider" as companion4soloplayer.core.creation.inputs.MappingInputProvider {
  #_answers : dict[str, Any]
  +answers : Mapping[str, Any]
  +<color:#008000>__init__(answers: Mapping[str, Any] | None) -> None</color>
  #<color:#008000>_to_int(key: str, answer: Any) -> int</color>
  +<color:#008000>ask_choice(key: str, prompt: str, options: Sequence[Any]) -> Any</color>
  +<color:#008000>ask_many(key: str, prompt: str, options: Sequence[Any]) -> list[Any]</color>
  +<color:#008000>ask_number(key: str, prompt: str) -> int</color>
  +<color:#008000>ask_text(key: str, prompt: str) -> str</color>
}
class "<color:red>MissingInputError</color>" as companion4soloplayer.core.creation.inputs.MissingInputError {
}
companion4soloplayer.core.creation.inputs.InvalidAnswerError --|> companion4soloplayer.core.creation.inputs.InputError
companion4soloplayer.core.creation.inputs.MissingInputError --|> companion4soloplayer.core.creation.inputs.InputError
companion4soloplayer.core.creation.inputs.InputField --> companion4soloplayer.core.creation.inputs.InputKind : kind

' --- Force vertical alignment ---
companion4soloplayer.core.creation.inputs.InputError -[hidden]down-> companion4soloplayer.core.creation.inputs.InputField
companion4soloplayer.core.creation.inputs.InputField -[hidden]down-> companion4soloplayer.core.creation.inputs.InputKind
companion4soloplayer.core.creation.inputs.InputKind -[hidden]down-> companion4soloplayer.core.creation.inputs.InputProvider
companion4soloplayer.core.creation.inputs.InputProvider -[hidden]down-> companion4soloplayer.core.creation.inputs.InvalidAnswerError
companion4soloplayer.core.creation.inputs.InvalidAnswerError -[hidden]down-> companion4soloplayer.core.creation.inputs.MappingInputProvider
companion4soloplayer.core.creation.inputs.MappingInputProvider -[hidden]down-> companion4soloplayer.core.creation.inputs.MissingInputError


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
