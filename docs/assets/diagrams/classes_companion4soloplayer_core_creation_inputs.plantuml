  +value : int | str | None
  +<color:#008000><b>__init__(self, key: str, label: str, kind: InputKind, options: tuple[str, ...], required: bool, min_count: int, max_count: int | None, min_value: int | None, max_value: int | None, roll: Callable[[], int] | None, description: str, option_descriptions: tuple[tuple[str, str], ...], value: int | str | None) -> None</b></color>
  +<color:#008000><b>option_description(option: str) -> str</b></color>
}
