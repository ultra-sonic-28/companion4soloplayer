set namespaceSeparator none
class "<color:red>InputError</color>" as companion4soloplayer.core.creation.inputs.InputError #77AADD {
}
class "InputField" as companion4soloplayer.core.creation.inputs.InputField #77AADD {
  +description : str
  +key : str
  +kind
  +label : str
  +max_count : int | None
  +max_value : int | None
