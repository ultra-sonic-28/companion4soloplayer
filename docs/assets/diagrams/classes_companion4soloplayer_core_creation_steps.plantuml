@startuml classes_companion4soloplayer_core_creation_steps

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "AttributeGenerationStep" as companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep {
  #_attributes : NoneType, tuple
  #_block : str
  #_manual_attributes : tuple
  #_max_value : NoneType
  #_min_value : NoneType
  #_mode : str
  #_roller : NoneType
  #_strategy : NoneType
  #_target : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  #<color:#008000>_block_entries(context: CharacterCreationContext) -> Any</color>
  #<color:#008000>_is_manual(attribute: str) -> bool</color>
  #<color:#008000>_read_attribute_entry(entry: Mapping[str, Any], position: int, source: str) -> dict[str, str]</color>
  #<color:#008000>_resolve_strategy(context: CharacterCreationContext) -> AttributeGenerationStrategy</color>
  +<color:#008000>attribute_descriptions(context: CharacterCreationContext) -> dict[str, str]</color>
  +<color:#008000>attribute_entries(context: CharacterCreationContext) -> list[dict[str, str]]</color>
  +<color:#008000>attribute_labels(context: CharacterCreationContext) -> dict[str, str]</color>
  +<color:#008000>attribute_names(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>display_label(context: CharacterCreationContext) -> str</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>roll_attribute(attribute: str, context: CharacterCreationContext, roller: DiceRoller | None) -> int</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "CreationStep" as companion4soloplayer.core.creation.steps.base.CreationStep {
  #_label
  #_step_id
  +label : str
  +step_id : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>__repr__() -> str</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>display_label(context: CharacterCreationContext) -> str</color>
  +<color:#FF0000>{abstract}execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#FF0000>{abstract}is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#FF0000>{abstract}validate(context: CharacterCreationContext) -> list[str]</color>
}
class "IdentityStep" as companion4soloplayer.core.creation.steps.identity.IdentityStep {
  #_background_options : NoneType, tuple
  #_background_prompt : str
  #_background_required : bool
  #_name_prompt : str
  #_name_required : bool
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "SelectionStep" as companion4soloplayer.core.creation.steps.selection.SelectionStep {
  #_catalog : NoneType
  #_optional : bool
  #_options_source : NoneType
  #_prompt
  #_target
  +target : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>available(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "SkillSelectionStep" as companion4soloplayer.core.creation.steps.skills.SkillSelectionStep {
  #_catalog : str
  #_max_count : NoneType
  #_min_count : int
  #_mode : str
  #_prompt : str
  #_skill_filter : NoneType
  #_target : str
  #_working_target : str
  +mode : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>available(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "SpellSelectionStep" as companion4soloplayer.core.creation.steps.spells.SpellSelectionStep {
  #_catalog : str
  #_max_count : NoneType
  #_min_count : int
  #_mode : str
  #_prompt : str
  #_spell_filter : NoneType
  #_target : str
  #_working_target : str
  +mode : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>available(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "<color:red>StepConfigurationError</color>" as companion4soloplayer.core.creation.steps.base.StepConfigurationError {
}
class "StepResult" as companion4soloplayer.core.creation.steps.base.StepResult {
  +errors : tuple[str, ...]
  +executed : bool
  +ok : bool
  +status
  +step_id : str
  +<color:#008000>__init__(self, step_id: str, status: StepStatus, errors: tuple[str, ...]) -> None</color>
}
class "StepStatus" as companion4soloplayer.core.creation.steps.base.StepStatus {
  +name
}
companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.identity.IdentityStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.selection.SelectionStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.skills.SkillSelectionStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.spells.SpellSelectionStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.base.StepResult --> companion4soloplayer.core.creation.steps.base.StepStatus : status

' --- Force vertical alignment ---
companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep -[hidden]down-> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.base.CreationStep -[hidden]down-> companion4soloplayer.core.creation.steps.identity.IdentityStep
companion4soloplayer.core.creation.steps.identity.IdentityStep -[hidden]down-> companion4soloplayer.core.creation.steps.selection.SelectionStep
companion4soloplayer.core.creation.steps.selection.SelectionStep -[hidden]down-> companion4soloplayer.core.creation.steps.skills.SkillSelectionStep
companion4soloplayer.core.creation.steps.skills.SkillSelectionStep -[hidden]down-> companion4soloplayer.core.creation.steps.spells.SpellSelectionStep
companion4soloplayer.core.creation.steps.spells.SpellSelectionStep -[hidden]down-> companion4soloplayer.core.creation.steps.base.StepConfigurationError
companion4soloplayer.core.creation.steps.base.StepConfigurationError -[hidden]down-> companion4soloplayer.core.creation.steps.base.StepResult
companion4soloplayer.core.creation.steps.base.StepResult -[hidden]down-> companion4soloplayer.core.creation.steps.base.StepStatus


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
