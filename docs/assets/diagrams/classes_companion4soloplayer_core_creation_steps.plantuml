  +<color:#008000><b>display_label(context: CharacterCreationContext) -> str</b></color>
  +<color:#008000><b>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</b></color>
  +<color:#008000><b>is_applicable(context: CharacterCreationContext) -> bool</b></color>
  +<color:#008000><b>roll_attribute(attribute: str, context: CharacterCreationContext, roller: DiceRoller | None) -> int</b></color>
  +<color:#008000><b>validate(context: CharacterCreationContext) -> list[str]</b></color>
}
class "CreationStep" as companion4soloplayer.core.creation.steps.base.CreationStep #77AADD {
  #_label
  #_step_id
  +label : str
  +step_id : str
