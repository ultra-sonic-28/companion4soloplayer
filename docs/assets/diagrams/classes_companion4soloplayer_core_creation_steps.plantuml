  +<color:#008000><b>__repr__() -> str</b></color>
  +<color:#008000><b>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</b></color>
  +<color:#008000><b>display_label(context: CharacterCreationContext) -> str</b></color>
  {abstract}execute(context: CharacterCreationContext, inputs: InputProvider) -> None
  {abstract}is_applicable(context: CharacterCreationContext) -> bool
  {abstract}validate(context: CharacterCreationContext) -> list[str]
}
