  #_block : str
  #_manual_attributes : tuple
  #_max_value : NoneType
  #_min_value : NoneType
  #_mode : str
  #_roller : NoneType
  #_strategy : NoneType
  #_target : str
  +<color:#008000><b>__init__(step_id: str) -> None</b></color>
  #<color:#008000><b>_block_entries(context: CharacterCreationContext) -> Any</b></color>
  #<color:#008000><b>_is_manual(attribute: str) -> bool</b></color>
  #<color:#008000><b>_read_attribute_entry(entry: Mapping[str, Any], position: int, source: str) -> dict[str, str]</b></color>
  #<color:#008000><b>_resolve_strategy(context: CharacterCreationContext) -> AttributeGenerationStrategy</b></color>
  +<color:#008000><b>attribute_descriptions(context: CharacterCreationContext) -> dict[str, str]</b></color>
  +<color:#008000><b>attribute_entries(context: CharacterCreationContext) -> list[dict[str, str]]</b></color>
  +<color:#008000><b>attribute_labels(context: CharacterCreationContext) -> dict[str, str]</b></color>
  +<color:#008000><b>attribute_names(context: CharacterCreationContext) -> list[str]</b></color>
