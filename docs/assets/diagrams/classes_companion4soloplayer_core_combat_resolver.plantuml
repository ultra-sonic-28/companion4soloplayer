@startuml classes_companion4soloplayer_core_combat_resolver
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
' -----------------------------------------------
set namespaceSeparator none
class "CombatResolver" as companion4soloplayer.core.combat_resolver.CombatResolver #77AADD {
  +dice_roller : DiceRoller
  +<color:#008000><b>__init__() -> None</b></color>
  +<color:#008000><b>apply_damage(character: Character, damage: int) -> int</b></color>
  +<color:#008000><b>calculate_damage(attacker: Character, defender: Character, weapon_damage: int) -> int</b></color>
}
@enduml
