@startuml classes_companion4soloplayer_ui

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "AboutDialog" as companion4soloplayer.ui.dialogs.about_dialog.AboutDialog {
  +close_button
  +logo_label
  +<color:#008000>__init__(parent: QWidget | None) -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
}
class "CharacterCreationDialog" as companion4soloplayer.ui.builder.creation_dialog.CharacterCreationDialog {
  #_builder
  #_container
  #_context : CharacterCreationContext | None
  #_form_layout
  #_in_refresh : bool
  #_pipeline : CharacterCreationPipeline
  #_report : CreationReport | None
  #_sections : list[StepSection]
  +answers : dict[str, Any]
  +cancel_button
  +context : CharacterCreationContext | None
  +error_label
  +report : CreationReport | None
  +sections : tuple[StepSection, ...]
  +validate_button
  +<color:#008000>__init__(pipeline: CharacterCreationPipeline, parent: QWidget | None) -> None</color>
  #<color:#008000>_insert_section(section: StepSection) -> None</color>
  #<color:#008000>_on_field_changed() -> None</color>
  #<color:#008000>_on_roll(widget: DiceField) -> None</color>
  #<color:#008000>_on_validate() -> None</color>
  #<color:#008000>_refresh_sections() -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  #<color:#008000>_sync_sections(context: CharacterCreationContext) -> None</color>
  #<color:#008000>_wire_section(section: StepSection) -> None</color>
}
class "CharacterCreationDialogBuilder" as companion4soloplayer.ui.builder.dialog_builder.CharacterCreationDialogBuilder {
  #_attributes_columns
  #_pipeline : CharacterCreationPipeline
  +attributes_columns : int
  +pipeline : CharacterCreationPipeline
  +<color:#008000>__init__(pipeline: CharacterCreationPipeline) -> None</color>
  #<color:#008000>_fill_section(box: QGroupBox, fields: Sequence[InputField]) -> tuple[tuple[InputField, FieldWidget], ...]</color>
  +<color:#008000>arrange(layout: QGridLayout, sections: Sequence[StepSection]) -> None</color>
  +<color:#008000>build() -> list[StepSection]</color>
  +<color:#008000>build_section(step: CreationStep) -> StepSection | None</color>
}
class "ChoiceField" as companion4soloplayer.ui.builder.fields.ChoiceField {
  #_list_tooltip
  #_option_descriptions : dict[str, str]
  #_options : tuple[str, ...]
  +label
  +list
  +option_descriptions : dict[str, str]
  +options : tuple[str, ...]
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  #<color:#008000>_apply_list_height() -> None</color>
  +<color:#008000>set_option_descriptions(option_descriptions: Sequence[tuple[str, str]] | Mapping[str, str]) -> None</color>
  +<color:#008000>set_options(options: Sequence[str]) -> None</color>
  +<color:#008000>value() -> str | list[str] | None</color>
}
class "DescriptionTooltip" as companion4soloplayer.ui.widgets.tooltip.DescriptionTooltip {
  #_frame
  #_label
  #_max_width
  #_min_width
  #_offset
  #_padding
  #_shared : Optional[ClassVar[DescriptionTooltip | None]]
  #_style_sheet : NoneType
  +text : str
  +<color:#008000>__init__() -> None</color>
  #<color:#008000>_position_for(size: QSize, cursor: QPoint, available: QRect | None) -> QPoint</color>
  #<color:#008000>_preferred_size(text: str, available: QRect | None) -> QSize</color>
  #<color:#008000>_screen_for(cursor: QPoint) -> QScreen | None</color>
  +<color:#008000>hide_description() -> None</color>
  +<color:#008000>shared() -> DescriptionTooltip</color>
  +<color:#008000>show_description(text: str, cursor: QPoint | None) -> None</color>
}
class "DescriptionTooltipFilter" as companion4soloplayer.ui.widgets.tooltip.DescriptionTooltipFilter {
  #_describe : Callable[[QObject, QPoint], str]
  #_tooltip
  +<color:#008000>__init__(tooltip: DescriptionTooltip, describe: Callable[[QObject, QPoint], str]) -> None</color>
  #<color:#008000>_apply(watched: QObject, position: QPoint) -> None</color>
  +<color:#008000>eventFilter(watched: QObject, event: QEvent) -> bool</color>
}
class "DiceField" as companion4soloplayer.ui.builder.fields.DiceField {
  #_value : int | None
  +die_button
  +label
  +value_label
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  +<color:#008000>set_rolled_value(value: int) -> None</color>
  +<color:#008000>value() -> int | None</color>
}
class "FieldWidget" as companion4soloplayer.ui.builder.fields.FieldWidget {
  #_description_tooltip : DescriptionTooltipFilter | None
  #_field : InputField
  +changed
  +field : InputField
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  #<color:#008000>_emit_changed(_text: str) -> None</color>
  +<color:#FF0000>{abstract}set_options(options: Sequence[str]) -> None</color>
  +<color:#FF0000>{abstract}value() -> Any</color>
}
class "MainWindow" as companion4soloplayer.ui.main_window.MainWindow {
  #_config : ConfigManager | None
  #_player_action
  #_plugin_loader : PluginLoader
  #_start_maximized : bool
  +status_bar
  +tab_widget
  +<color:#008000>__init__(config: ConfigManager | None) -> None</color>
  #<color:#008000>_add_character_tab() -> None</color>
  #<color:#008000>_add_dungeon_tab() -> None</color>
  #<color:#008000>_add_quest_tab() -> None</color>
  #<color:#008000>_apply_theme(theme: str) -> None</color>
  #<color:#008000>_configured_theme() -> str</color>
  #<color:#008000>_creation_plugin() -> tuple[str, GamePlugin] | None</color>
  #<color:#008000>_refresh_player_action() -> None</color>
  #<color:#008000>_restore_window_settings() -> None</color>
  #<color:#008000>_save_window_settings() -> None</color>
  #<color:#008000>_setup_menu_bar() -> None</color>
  #<color:#008000>_setup_status_bar() -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  #<color:#008000>_show_about() -> None</color>
  #<color:#008000>_show_player() -> None</color>
  #<color:#008000>_show_plugin() -> None</color>
  #<color:#008000>_show_quest() -> None</color>
  #<color:#008000>_show_settings() -> None</color>
  +<color:#008000>closeEvent(event: QCloseEvent) -> None</color>
  +<color:#008000>show() -> None</color>
}
class "NumberField" as companion4soloplayer.ui.builder.fields.NumberField {
  +edit
  +label
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  +<color:#008000>value() -> int | None</color>
}
class "PluginMetadataDialog" as companion4soloplayer.ui.dialogs.plugin_metadata_dialog.PluginMetadataDialog {
  #_loaded : bool
  #_manifest : Mapping[str, Any]
  +close_button
  +loaded_badge
  +<color:#008000>__init__(manifest: Mapping[str, Any], loaded: bool, parent: QWidget | None) -> None</color>
  #<color:#008000>_build_games_tags() -> QFrame</color>
  #<color:#008000>_build_header() -> QFrame</color>
  #<color:#008000>_build_loaded_badge() -> QFrame</color>
  #<color:#008000>_build_text_edit(value: str) -> QTextEdit</color>
  #<color:#008000>_pair_row(left: QFrame, right: QFrame) -> QHBoxLayout</color>
  #<color:#008000>_section_label(text: str) -> QLabel</color>
  #<color:#008000>_setup_ui() -> None</color>
  #<color:#008000>_value_block(caption: str, value: str) -> QFrame</color>
}
class "PluginsDialog" as companion4soloplayer.ui.dialogs.plugins_dialog.PluginsDialog {
  #_plugin_loader : PluginLoader
  #_plugin_rows : dict[str, tuple[QPushButton, QTableWidgetItem]]
  +close_button
  +plugin_state_changed
  +table
  +<color:#008000>__init__(parent: QWidget | None, plugin_loader: PluginLoader | None) -> None</color>
  #<color:#008000>_report_status(message: str) -> None</color>
  #<color:#008000>_set_loaded_state(plugin_name: str, loaded: bool) -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  #<color:#008000>_show_metadata(plugin_name: str) -> None</color>
  #<color:#008000>_toggle_plugin(plugin_name: str) -> None</color>
}
class "QuestWizard" as companion4soloplayer.ui.dialogs.quest_wizard.QuestWizard {
  +cancel_button
  +create_button
  +description_input
  +difficulty_spin
  +name_input
  +num_rooms_spin
  +template_combo
  +<color:#008000>__init__(parent: QWidget | None) -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  +<color:#008000>get_quest_data() -> dict</color>
}
class "ReadOnlyField" as companion4soloplayer.ui.builder.fields.ReadOnlyField {
  #_value : int | str | None
  +displayed_value : int | str | None
  +label
  +value_label
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  +<color:#008000>set_value(value: int | str | None) -> None</color>
  +<color:#008000>value() -> int | str | None</color>
}
class "SettingsDialog" as companion4soloplayer.ui.dialogs.settings_dialog.SettingsDialog {
  #_config : NoneType
  +animations_check
  +auto_save_check
  +cancel_button
  +font_size_spin
  +save_button
  +sound_check
  +theme_changed
  +theme_combo
  +<color:#008000>__init__(parent: QWidget | None, config: ConfigManager | None) -> None</color>
  #<color:#008000>_load_appearance() -> None</color>
  #<color:#008000>_on_theme_changed(theme: str) -> None</color>
  #<color:#008000>_save_appearance() -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  +<color:#008000>accept() -> None</color>
  +<color:#008000>get_settings() -> dict</color>
}
class "SplashScreen" as companion4soloplayer.ui.splash_window.SplashScreen {
  +duration_ms : int
  +<color:#008000>__init__(duration_ms: int)</color>
  #<color:#008000>_setup_timer() -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  +<color:#008000>show() -> None</color>
}
class "StepSection" as companion4soloplayer.ui.builder.dialog_builder.StepSection {
  +box
  +label : str
  +rows : tuple[tuple[InputField, FieldWidget], ...]
  +step_id : str
  +widgets : tuple[FieldWidget, ...]
  +<color:#008000>__init__(self, step_id: str, label: str, box: QGroupBox, rows: tuple[tuple[InputField, FieldWidget], ...]) -> None</color>
}
class "TextAreaField" as companion4soloplayer.ui.builder.fields.TextAreaField {
  +edit
  +label
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  +<color:#008000>value() -> str | None</color>
}
class "TextField" as companion4soloplayer.ui.builder.fields.TextField {
  +edit
  +label
  +<color:#008000>__init__(field: InputField, parent: QWidget | None) -> None</color>
  +<color:#008000>value() -> str | None</color>
}
companion4soloplayer.ui.builder.fields.ChoiceField --|> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.fields.DiceField --|> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.fields.NumberField --|> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.fields.ReadOnlyField --|> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.fields.TextAreaField --|> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.fields.TextField --|> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.dialog_builder.CharacterCreationDialogBuilder --* companion4soloplayer.ui.builder.creation_dialog.CharacterCreationDialog : _builder
companion4soloplayer.ui.widgets.tooltip.DescriptionTooltipFilter --* companion4soloplayer.ui.builder.fields.ChoiceField : _list_tooltip
companion4soloplayer.ui.widgets.tooltip.DescriptionTooltipFilter --* companion4soloplayer.ui.builder.fields.FieldWidget : _description_tooltip
companion4soloplayer.ui.widgets.tooltip.DescriptionTooltip --o companion4soloplayer.ui.widgets.tooltip.DescriptionTooltipFilter : _tooltip

' --- Force vertical alignment ---
companion4soloplayer.ui.dialogs.about_dialog.AboutDialog -[hidden]down-> companion4soloplayer.ui.builder.creation_dialog.CharacterCreationDialog
companion4soloplayer.ui.builder.creation_dialog.CharacterCreationDialog -[hidden]down-> companion4soloplayer.ui.builder.dialog_builder.CharacterCreationDialogBuilder
companion4soloplayer.ui.builder.dialog_builder.CharacterCreationDialogBuilder -[hidden]down-> companion4soloplayer.ui.builder.fields.ChoiceField
companion4soloplayer.ui.builder.fields.ChoiceField -[hidden]down-> companion4soloplayer.ui.widgets.tooltip.DescriptionTooltip
companion4soloplayer.ui.widgets.tooltip.DescriptionTooltip -[hidden]down-> companion4soloplayer.ui.widgets.tooltip.DescriptionTooltipFilter
companion4soloplayer.ui.widgets.tooltip.DescriptionTooltipFilter -[hidden]down-> companion4soloplayer.ui.builder.fields.DiceField
companion4soloplayer.ui.builder.fields.DiceField -[hidden]down-> companion4soloplayer.ui.builder.fields.FieldWidget
companion4soloplayer.ui.builder.fields.FieldWidget -[hidden]down-> companion4soloplayer.ui.main_window.MainWindow
companion4soloplayer.ui.main_window.MainWindow -[hidden]down-> companion4soloplayer.ui.builder.fields.NumberField
companion4soloplayer.ui.builder.fields.NumberField -[hidden]down-> companion4soloplayer.ui.dialogs.plugin_metadata_dialog.PluginMetadataDialog
companion4soloplayer.ui.dialogs.plugin_metadata_dialog.PluginMetadataDialog -[hidden]down-> companion4soloplayer.ui.dialogs.plugins_dialog.PluginsDialog
companion4soloplayer.ui.dialogs.plugins_dialog.PluginsDialog -[hidden]down-> companion4soloplayer.ui.dialogs.quest_wizard.QuestWizard
companion4soloplayer.ui.dialogs.quest_wizard.QuestWizard -[hidden]down-> companion4soloplayer.ui.builder.fields.ReadOnlyField
companion4soloplayer.ui.builder.fields.ReadOnlyField -[hidden]down-> companion4soloplayer.ui.dialogs.settings_dialog.SettingsDialog
companion4soloplayer.ui.dialogs.settings_dialog.SettingsDialog -[hidden]down-> companion4soloplayer.ui.splash_window.SplashScreen
companion4soloplayer.ui.splash_window.SplashScreen -[hidden]down-> companion4soloplayer.ui.builder.dialog_builder.StepSection
companion4soloplayer.ui.builder.dialog_builder.StepSection -[hidden]down-> companion4soloplayer.ui.builder.fields.TextAreaField
companion4soloplayer.ui.builder.fields.TextAreaField -[hidden]down-> companion4soloplayer.ui.builder.fields.TextField


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
