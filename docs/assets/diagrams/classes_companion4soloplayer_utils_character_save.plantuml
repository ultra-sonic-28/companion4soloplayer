@startuml classes_companion4soloplayer_utils_character_save

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
