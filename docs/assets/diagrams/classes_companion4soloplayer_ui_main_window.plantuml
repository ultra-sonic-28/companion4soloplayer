@startuml classes_companion4soloplayer_ui_main_window

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "MainWindow" as companion4soloplayer.ui.main_window.MainWindow {
  #_config : ConfigManager | None
  #_player_action
  #_plugin_loader : PluginLoader
  #_start_maximized : bool
  +status_bar
  +tab_widget
  +<color:#008000>__init__(config: ConfigManager | None) -> None</color>
  #<color:#008000>_add_character_tab() -> None</color>
  #<color:#008000>_add_dungeon_tab() -> None</color>
  #<color:#008000>_add_quest_tab() -> None</color>
  #<color:#008000>_apply_theme(theme: str) -> None</color>
  #<color:#008000>_character_from_context(context: CharacterCreationContext) -> Character</color>
  #<color:#008000>_configured_theme() -> str</color>
  #<color:#008000>_creation_plugin() -> tuple[str, GamePlugin] | None</color>
  #<color:#008000>_refresh_player_action() -> None</color>
  #<color:#008000>_restore_window_settings() -> None</color>
  #<color:#008000>_save_created_character(plugin_name: str, context: CharacterCreationContext | None) -> bool</color>
  #<color:#008000>_save_window_settings() -> None</color>
  #<color:#008000>_setup_menu_bar() -> None</color>
  #<color:#008000>_setup_status_bar() -> None</color>
  #<color:#008000>_setup_ui() -> None</color>
  #<color:#008000>_show_about() -> None</color>
  #<color:#008000>_show_player() -> None</color>
  #<color:#008000>_show_plugin() -> None</color>
  #<color:#008000>_show_quest() -> None</color>
  #<color:#008000>_show_settings() -> None</color>
  +<color:#008000>closeEvent(event: QCloseEvent) -> None</color>
  +<color:#008000>show() -> None</color>
}

' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
