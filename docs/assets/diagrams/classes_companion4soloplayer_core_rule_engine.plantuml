@startuml classes_companion4soloplayer_core_rule_engine

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "<color:red>ImplementationError</color>" as companion4soloplayer.core.rule_engine.ImplementationError {
}
class "<color:red>ImplementationNotAllowedError</color>" as companion4soloplayer.core.rule_engine.ImplementationNotAllowedError {
}
class "RuleEngine" as companion4soloplayer.core.rule_engine.RuleEngine {
  #_allowed_modules : tuple
  #_base_module : NoneType
  #_components : dict[str, Any]
  #_rules : dict
  +implementations : dict[str, PyClassRef]
  +kinds : list[str]
  +rules : dict[str, Any]
  +<color:#008000>__init__(rules: Mapping[str, Any]) -> None</color>
  #<color:#008000>_import_allowed_module(module_name: str) -> types.ModuleType</color>
  #<color:#008000>_resolve_base_module() -> types.ModuleType</color>
  #<color:#008000>_resolve_through_canonical_path(module_obj: types.ModuleType, attr_name: str) -> Any</color>
  +<color:#008000>component(kind: str) -> Any</color>
  +<color:#008000>from_yaml(path: str | Path) -> RuleEngine</color>
  +<color:#008000>get(key: str, default: Any) -> Any</color>
  +<color:#008000>resolve(ref: PyClassRef | str) -> Any</color>
}
class "<color:red>RuleEngineError</color>" as companion4soloplayer.core.rule_engine.RuleEngineError {
}
class "<color:red>UnknownRuleKindError</color>" as companion4soloplayer.core.rule_engine.UnknownRuleKindError {
}
companion4soloplayer.core.rule_engine.ImplementationError --|> companion4soloplayer.core.rule_engine.RuleEngineError
companion4soloplayer.core.rule_engine.ImplementationNotAllowedError --|> companion4soloplayer.core.rule_engine.ImplementationError
companion4soloplayer.core.rule_engine.UnknownRuleKindError --|> companion4soloplayer.core.rule_engine.RuleEngineError

' --- Force vertical alignment ---
companion4soloplayer.core.rule_engine.ImplementationError -[hidden]down-> companion4soloplayer.core.rule_engine.ImplementationNotAllowedError
companion4soloplayer.core.rule_engine.ImplementationNotAllowedError -[hidden]down-> companion4soloplayer.core.rule_engine.RuleEngine
companion4soloplayer.core.rule_engine.RuleEngine -[hidden]down-> companion4soloplayer.core.rule_engine.RuleEngineError
companion4soloplayer.core.rule_engine.RuleEngineError -[hidden]down-> companion4soloplayer.core.rule_engine.UnknownRuleKindError


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
