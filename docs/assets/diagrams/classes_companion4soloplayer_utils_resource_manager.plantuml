' -----------------------------------------------

set namespaceSeparator none
class "ResourceManager" as companion4soloplayer.utils.resource_manager.ResourceManager {
  #_EXTENSIONS : dict[str, tuple[str, ...]]
  #_SUBDIRS : dict[str, str]
  #_initialized : ClassVar[bool]
  #_instance : Optional[ClassVar[ResourceManager | None]]
  #_object_cache : dict[str, object]
  #_path_cache : dict[str, Path]
  #_root : Path
  #_strict : bool
  +root : Path
  +<color:#008000>__init__(root: Path | str | None) -> None</color>
  +<color:#008000>__new__() -> Self</color>
  #<color:#008000>_detect_root(root: Path | str | None) -> Path</color>
  #<color:#008000>_validate(path: Path, category: str) -> None</color>
  +<color:#008000>clear_cache() -> None</color>
  +<color:#008000>get_data(name: str) -> Path</color>
  +<color:#008000>get_file(name: str) -> Path</color>
  +<color:#008000>get_font(name: str) -> Path</color>
  +<color:#008000>get_icon(name: str) -> Path</color>
  +<color:#008000>get_image(name: str) -> Path</color>
  +<color:#008000>get_music(name: str) -> Path</color>
  +<color:#008000>get_resource(name: str) -> Path</color>
  +<color:#008000>get_sound(name: str) -> Path</color>
  +<color:#008000>instance() -> Self</color>
  +<color:#008000>list_resources(category: str) -> list[Path]</color>
  +<color:#008000>load_icon(name: str) -> QIcon</color>
  +<color:#008000>load_pixmap(name: str) -> QPixmap</color>
  +<color:#008000>load_sound(name: str) -> QSoundEffect</color>
  +<color:#008000>reset() -> None</color>
}
class "<color:red>ResourceNotFoundError</color>" as companion4soloplayer.utils.resource_manager.ResourceNotFoundError {
}

' --- Force vertical alignment ---
companion4soloplayer.utils.resource_manager.ResourceManager -[hidden]down-> companion4soloplayer.utils.resource_manager.ResourceNotFoundError


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
