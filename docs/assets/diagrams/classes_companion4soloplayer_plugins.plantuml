@startuml classes_companion4soloplayer_plugins

' -----------------------------------------------
' --- Custom Styling: Visibility & Colors ---
skinparam classAttributeFontColor #0055FF
skinparam classAttributeFontStyle normal
skinparam classFontColor #333333
skinparam classFontStyle normal
skinparam Shadowing true

' --- Legend color configuration ---
<style>
legend {
  BackGroundColor #FFF8DC
  LineColor       #B8860B
  FontColor       #333333
  FontSize        12
}
</style>
' -----------------------------------------------
' --- Custom icons ---
' 1. Public
sprite $icon_public {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000000FFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000FFFFFFFF0000
000000FFFF000000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}

' 2. Protected
sprite $icon_protected {
0000000000000000
0000000F00000000
000000FFF0000000
00000FFFFF000000
0000FFFFFFFF0000
000FFFFFFFFFF000
00FFFFFFFFFFFF00
0FFFFFFFFFFFFFF0
0FFFFFFFFFFFFFF0
00FFFFFFFFFFFF00
000FFFFFFFFFF000
0000FFFFFFFF0000
00000FFFFF000000
000000FFF0000000
0000000F00000000
0000000000000000
}

' 3. Private
sprite $icon_private {
0000000000000000
0000000000000000
0000000000000000
0000000000000000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
000FFFFFFFFFF000
0000000000000000
0000000000000000
0000000000000000
0000000000000000
}
' -----------------------------------------------

set namespaceSeparator none
class "CharacterCreationRule" as companion4soloplayer.plugins.demo_plugin.rules.character_creation_rule.CharacterCreationRule {
  +catalog : str
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>create(class_name: str, character_name: str) -> dict</color>
  +<color:#008000>list_abilities(class_name: str) -> list[str]</color>
  +<color:#008000>list_classes() -> list[dict]</color>
}
class "ClassSavesStrategy" as companion4soloplayer.plugins.demo_plugin.creation.strategies.ClassSavesStrategy {
  +default : int
  +<color:#008000>__init__(default: int) -> None</color>
  +<color:#008000>roll(attribute: str, roller: DiceRoller) -> int</color>
  +<color:#008000>roll_for(attribute: str, roller: DiceRoller, context: CharacterCreationContext) -> int</color>
}
class "CombatRule" as companion4soloplayer.plugins.demo_plugin.rules.combat_rule.CombatRule {
  +attack_dice : DiceExpression
  +attack_stat : str
  +base_damage : int
  +defense_dice : DiceExpression, NoneType
  +defense_stat : str
  +max_damage : int
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>resolve(attacker: Mapping[str, Any], defender: Mapping[str, Any], roller: DiceRoller | None) -> dict</color>
}
class "FourSixKeepBestStrategy" as companion4soloplayer.plugins.demo_plugin.creation.strategies.FourSixKeepBestStrategy {
  #_roll : RollStrategy
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>roll(attribute: str, roller: DiceRoller) -> int</color>
}
class "LootRule" as companion4soloplayer.plugins.demo_plugin.rules.loot_rule.LootRule {
  +catalog : str
  +rolls : int
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>roll(count: int | None) -> list[dict]</color>
}
class "MagicRule" as companion4soloplayer.plugins.demo_plugin.rules.magic_rule.MagicRule {
  +dice : DiceExpression
  +difficulty : int
  +mana_cost : int
  +stat : str
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>cast(spell: str, caster: Mapping[str, Any], roller: DiceRoller | None) -> dict</color>
}
class "Plugin" as companion4soloplayer.plugins.demo_plugin.plugin.Plugin {
  #_creation : CharacterCreationPipeline | None
  #_engine : RuleEngine | None
  #_metadata
  +description : str
  +name : str
  +version : str
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>create_character_creation() -> CharacterCreationPipeline</color>
  +<color:#008000>create_component(kind: str) -> Any</color>
  +<color:#008000>generate_dungeon(config: dict) -> dict</color>
  +<color:#008000>get_classes() -> list[dict]</color>
  +<color:#008000>get_items() -> list[dict]</color>
  +<color:#008000>get_monsters() -> list[dict]</color>
  +<color:#008000>get_rule_engine() -> RuleEngine</color>
  +<color:#008000>get_rules() -> dict</color>
}
class "PluginMetadata" as companion4soloplayer.plugins.demo_plugin.manifest.PluginMetadata {
  +author : str | None
  +compatible_games : list[str]
  +dependencies : dict[str, str]
  +description : str
  +disclaimer : str
  +features : str
  +license : str | None
  +name : str
  +version : str
}
companion4soloplayer.plugins.demo_plugin.manifest.PluginMetadata --* companion4soloplayer.plugins.demo_plugin.plugin.Plugin : _metadata

' --- Force vertical alignment ---
companion4soloplayer.plugins.demo_plugin.rules.character_creation_rule.CharacterCreationRule -[hidden]down-> companion4soloplayer.plugins.demo_plugin.creation.strategies.ClassSavesStrategy
companion4soloplayer.plugins.demo_plugin.creation.strategies.ClassSavesStrategy -[hidden]down-> companion4soloplayer.plugins.demo_plugin.rules.combat_rule.CombatRule
companion4soloplayer.plugins.demo_plugin.rules.combat_rule.CombatRule -[hidden]down-> companion4soloplayer.plugins.demo_plugin.creation.strategies.FourSixKeepBestStrategy
companion4soloplayer.plugins.demo_plugin.creation.strategies.FourSixKeepBestStrategy -[hidden]down-> companion4soloplayer.plugins.demo_plugin.rules.loot_rule.LootRule
companion4soloplayer.plugins.demo_plugin.rules.loot_rule.LootRule -[hidden]down-> companion4soloplayer.plugins.demo_plugin.rules.magic_rule.MagicRule
companion4soloplayer.plugins.demo_plugin.rules.magic_rule.MagicRule -[hidden]down-> companion4soloplayer.plugins.demo_plugin.plugin.Plugin
companion4soloplayer.plugins.demo_plugin.plugin.Plugin -[hidden]down-> companion4soloplayer.plugins.demo_plugin.manifest.PluginMetadata


' --- Visibility legend ---
legend right
  <size:14><b><color:#B8860B>Visibility legend</color></b></size>

  |= Icon |= Symbol |= Visibility |= Description |
  | <color:#84BE84><$icon_public></color> | + | Public | Public access |
  | <color:#FFD700><$icon_protected></color> | # | Protected | Only class and subclass can access |
  | <color:#FF0000><$icon_private></color> | - | Private | Only class can access |

  <size:14><b><color:#B8860B>Notes</color></b></size>
  * <color:#FF0000>Abstract methods</color> are displayed in <color:#FF0000>red</color> and in <color:#FF0000><i>italics</i></color>.
  * <color:#008000>Concrete methods</color> are displayed in <color:#008000>green</color>.
  * Attributes follow the standard visibility color scheme.
endlegend

@enduml
