companion4soloplayer.core.creation.rules.RuleDefinitionError -[hidden]down-> companion4soloplayer.core.creation.rules.RuleEvaluationError
companion4soloplayer.core.creation.rules.RuleEvaluationError -[hidden]down-> companion4soloplayer.core.creation.rules.RulesEngine
companion4soloplayer.core.creation.rules.RulesEngine -[hidden]down-> companion4soloplayer.core.creation.steps.selection.SelectionStep
companion4soloplayer.core.creation.steps.selection.SelectionStep -[hidden]down-> companion4soloplayer.core.creation.steps.skills.SkillSelectionStep
companion4soloplayer.core.creation.steps.skills.SkillSelectionStep -[hidden]down-> companion4soloplayer.core.creation.steps.spells.SpellSelectionStep
