set namespaceSeparator none
class "Action" as companion4soloplayer.core.creation.rules.Action {
  +name
  +<color:#008000>parse(value: Action | str) -> Action</color>
}
class "AttributeGenerationStep" as companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep {
  #_attributes : NoneType, tuple
  #_block : str
  #_manual_attributes : tuple
  #_max_value : NoneType
  #_min_value : NoneType
  #_mode : str
  #_roller : NoneType
  #_strategy : NoneType
  #_target : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  #<color:#008000>_block_entries(context: CharacterCreationContext) -> Any</color>
  #<color:#008000>_is_manual(attribute: str) -> bool</color>
  #<color:#008000>_read_attribute_entry(entry: Mapping[str, Any], position: int, source: str) -> dict[str, str]</color>
  #<color:#008000>_resolve_strategy(context: CharacterCreationContext) -> AttributeGenerationStrategy</color>
  +<color:#008000>attribute_descriptions(context: CharacterCreationContext) -> dict[str, str]</color>
  +<color:#008000>attribute_entries(context: CharacterCreationContext) -> list[dict[str, str]]</color>
  +<color:#008000>attribute_labels(context: CharacterCreationContext) -> dict[str, str]</color>
  +<color:#008000>attribute_names(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>display_label(context: CharacterCreationContext) -> str</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>roll_attribute(attribute: str, context: CharacterCreationContext, roller: DiceRoller | None) -> int</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "AttributeGenerationStrategy" as companion4soloplayer.core.creation.strategies.AttributeGenerationStrategy {
  +<color:#FF0000>{abstract}roll(attribute: str, roller: DiceRoller) -> int</color>
  +<color:#008000>roll_for(attribute: str, roller: DiceRoller, context: CharacterCreationContext) -> int</color>
}
class "CharacterCreationContext" as companion4soloplayer.core.creation.context.CharacterCreationContext {
  #_operations : dict[str, list[Any]]
  #_system : Mapping[str, Any]
  +choices : dict[str, Any]
  +executed_steps : list[str]
  +operations : Mapping[str, Sequence[Any]]
  +system : Mapping[str, Any]
  +values : dict[str, Any]
  +<color:#008000>__init__() -> None</color>
  +<color:#008000>__repr__() -> str</color>
  #<color:#008000>_root(namespace: str) -> dict[str, Any]</color>
  +<color:#008000>begin_evaluation() -> None</color>
  +<color:#008000>effective(path: str, default: Any) -> Any</color>
  +<color:#008000>export() -> dict[str, Any]</color>
  +<color:#008000>get(path: str) -> Any</color>
  +<color:#008000>has(path: str) -> bool</color>
  +<color:#008000>mark_executed(step_id: str) -> None</color>
  +<color:#008000>peek(path: str, default: Any) -> Any</color>
  +<color:#008000>record(path: str, effect: Any) -> None</color>
  +<color:#008000>set(path: str, value: Any) -> None</color>
}
class "CharacterCreationPipeline" as companion4soloplayer.core.creation.pipeline.CharacterCreationPipeline {
  #_rules
  #_steps : tuple
  #_stop_on_error : bool
  #_system : dict
  +rules : RulesEngine
  +steps : tuple[CreationStep, ...]
  +system : Mapping[str, Any]
  +<color:#008000>__init__(steps: Sequence[CreationStep]) -> None</color>
  +<color:#008000>__repr__() -> str</color>
  #<color:#008000>_evaluate(context: CharacterCreationContext) -> EvaluationReport</color>
  +<color:#008000>create_context() -> CharacterCreationContext</color>
  +<color:#008000>run(context: CharacterCreationContext, inputs: InputProvider) -> CreationReport</color>
}
class "Condition" as companion4soloplayer.core.creation.rules.Condition {
  +operator
  +target : str
  +value : Optional[Any]
  +<color:#008000>__init__(self, target: str, operator: Operator, value: Any) -> None</color>
  #<color:#008000>_check_container(value: Any, operator: str) -> None</color>
  #<color:#008000>_check_definition() -> None</color>
  #<color:#008000>_check_numbers(actual: Any, expected: Any) -> None</color>
  +<color:#008000>describe() -> str</color>
  +<color:#008000>evaluate(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>from_dict(data: Mapping[str, Any]) -> Condition</color>
}
class "ConstantStrategy" as companion4soloplayer.core.creation.strategies.ConstantStrategy {
  +value : int
  +<color:#008000>__init__(value: int) -> None</color>
  +<color:#008000>roll(attribute: str, roller: DiceRoller) -> int</color>
}
class "CreationReport" as companion4soloplayer.core.creation.pipeline.CreationReport {
  +completed : bool
  +errors : tuple[str, ...]
  +executed_steps : tuple[str, ...]
  +ok : bool
  +results : tuple[StepResult, ...]
  +rules_fired : tuple[str, ...]
  +total_steps : int
  +<color:#008000>__init__(self, results: tuple[StepResult, ...], rules_fired: tuple[str, ...], total_steps: int) -> None</color>
}
class "CreationRule" as companion4soloplayer.core.creation.rules.CreationRule {
  +description : str
  +effects : tuple[Effect, ...]
  +id : str
  +when : tuple[Condition, ...]
  +<color:#008000>__init__(self, id: str, description: str, when: tuple[Condition, ...], effects: tuple[Effect, ...]) -> None</color>
  +<color:#008000>from_dict(data: Mapping[str, Any]) -> CreationRule</color>
  +<color:#008000>matches(context: CharacterCreationContext) -> bool</color>
}
class "CreationStep" as companion4soloplayer.core.creation.steps.base.CreationStep {
  #_label
  #_step_id
  +label : str
  +step_id : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>__repr__() -> str</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>display_label(context: CharacterCreationContext) -> str</color>
  +<color:#FF0000>{abstract}execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#FF0000>{abstract}is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#FF0000>{abstract}validate(context: CharacterCreationContext) -> list[str]</color>
}
class "Effect" as companion4soloplayer.core.creation.rules.Effect {
  +action
  +target : str
  +value : Optional[Any]
  +<color:#008000>__init__(self, target: str, action: Action, value: Any) -> None</color>
  #<color:#008000>_apply_collection_action(base: Any) -> Any</color>
  +<color:#008000>apply_to(base: Any) -> Any</color>
  +<color:#008000>from_dict(data: Mapping[str, Any]) -> Effect</color>
}
class "EvaluationReport" as companion4soloplayer.core.creation.rules.EvaluationReport {
  +applied_effects : int
  +fired : tuple[str, ...]
  +<color:#008000>__init__(self, fired: tuple[str, ...], applied_effects: int) -> None</color>
}
class "IdentityStep" as companion4soloplayer.core.creation.steps.identity.IdentityStep {
  #_background_options : NoneType, tuple
  #_background_prompt : str
  #_background_required : bool
  #_name_prompt : str
  #_name_required : bool
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "<color:red>InputError</color>" as companion4soloplayer.core.creation.inputs.InputError {
}
class "InputField" as companion4soloplayer.core.creation.inputs.InputField {
  +description : str
  +key : str
  +kind
  +label : str
  +max_count : int | None
  +max_value : int | None
  +min_count : int
  +min_value : int | None
  +option_descriptions : tuple[tuple[str, str], ...]
  +options : tuple[str, ...]
  +required : bool
  +roll : Callable[[], int] | None
  +value : int | str | None
  +<color:#008000>__init__(self, key: str, label: str, kind: InputKind, options: tuple[str, ...], required: bool, min_count: int, max_count: int | None, min_value: int | None, max_value: int | None, roll: Callable[[], int] | None, description: str, option_descriptions: tuple[tuple[str, str], ...], value: int | str | None) -> None</color>
  +<color:#008000>option_description(option: str) -> str</color>
}
class "InputKind" as companion4soloplayer.core.creation.inputs.InputKind {
  +name
}
class "InputProvider" as companion4soloplayer.core.creation.inputs.InputProvider {
  +<color:#008000>ask_choice(key: str, prompt: str, options: Sequence[Any]) -> Any</color>
  +<color:#008000>ask_many(key: str, prompt: str, options: Sequence[Any]) -> list[Any]</color>
  +<color:#008000>ask_number(key: str, prompt: str) -> int</color>
  +<color:#008000>ask_text(key: str, prompt: str) -> str</color>
}
class "<color:red>InvalidAnswerError</color>" as companion4soloplayer.core.creation.inputs.InvalidAnswerError {
}
class "<color:red>InvalidPathError</color>" as companion4soloplayer.core.creation.context.InvalidPathError {
}
class "MappingInputProvider" as companion4soloplayer.core.creation.inputs.MappingInputProvider {
  #_answers : dict[str, Any]
  +answers : Mapping[str, Any]
  +<color:#008000>__init__(answers: Mapping[str, Any] | None) -> None</color>
  #<color:#008000>_to_int(key: str, answer: Any) -> int</color>
  +<color:#008000>ask_choice(key: str, prompt: str, options: Sequence[Any]) -> Any</color>
  +<color:#008000>ask_many(key: str, prompt: str, options: Sequence[Any]) -> list[Any]</color>
  +<color:#008000>ask_number(key: str, prompt: str) -> int</color>
  +<color:#008000>ask_text(key: str, prompt: str) -> str</color>
}
class "<color:red>MissingInputError</color>" as companion4soloplayer.core.creation.inputs.MissingInputError {
}
class "Operator" as companion4soloplayer.core.creation.rules.Operator {
  +name
  +<color:#008000>parse(value: Operator | str) -> Operator</color>
}
class "RollStrategy" as companion4soloplayer.core.creation.strategies.RollStrategy {
  +dice : DiceExpression
  +keep : NoneType
  +keep_best : bool
  +<color:#008000>__init__(dice: DiceExpression | str) -> None</color>
  +<color:#008000>roll(attribute: str, roller: DiceRoller) -> int</color>
  +<color:#008000>roll_detail(attribute: str, roller: DiceRoller) -> tuple[list[int], int]</color>
}
class "<color:red>RuleDefinitionError</color>" as companion4soloplayer.core.creation.rules.RuleDefinitionError {
}
class "<color:red>RuleEvaluationError</color>" as companion4soloplayer.core.creation.rules.RuleEvaluationError {
}
class "RulesEngine" as companion4soloplayer.core.creation.rules.RulesEngine {
  #_rules : list[CreationRule]
  +rules : tuple[CreationRule, ...]
  +<color:#008000>__init__(rules: Sequence[CreationRule]) -> None</color>
  +<color:#008000>add(rule: CreationRule) -> None</color>
  +<color:#008000>evaluate(context: CharacterCreationContext) -> EvaluationReport</color>
}
class "SelectionStep" as companion4soloplayer.core.creation.steps.selection.SelectionStep {
  #_catalog : NoneType
  #_optional : bool
  #_options_source : NoneType
  #_prompt
  #_target
  +target : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>available(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "SkillSelectionStep" as companion4soloplayer.core.creation.steps.skills.SkillSelectionStep {
  #_catalog : str
  #_max_count : NoneType
  #_min_count : int
  #_mode : str
  #_prompt : str
  #_skill_filter : NoneType
  #_target : str
  #_working_target : str
  +mode : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>available(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "SpellSelectionStep" as companion4soloplayer.core.creation.steps.spells.SpellSelectionStep {
  #_catalog : str
  #_max_count : NoneType
  #_min_count : int
  #_mode : str
  #_prompt : str
  #_spell_filter : NoneType
  #_target : str
  #_working_target : str
  +mode : str
  +<color:#008000>__init__(step_id: str) -> None</color>
  +<color:#008000>available(context: CharacterCreationContext) -> list[str]</color>
  +<color:#008000>describe_inputs(context: CharacterCreationContext) -> tuple[InputField, ...]</color>
  +<color:#008000>execute(context: CharacterCreationContext, inputs: InputProvider) -> None</color>
  +<color:#008000>is_applicable(context: CharacterCreationContext) -> bool</color>
  +<color:#008000>validate(context: CharacterCreationContext) -> list[str]</color>
}
class "<color:red>StepConfigurationError</color>" as companion4soloplayer.core.creation.steps.base.StepConfigurationError {
}
class "StepResult" as companion4soloplayer.core.creation.steps.base.StepResult {
  +errors : tuple[str, ...]
  +executed : bool
  +ok : bool
  +status
  +step_id : str
  +<color:#008000>__init__(self, step_id: str, status: StepStatus, errors: tuple[str, ...]) -> None</color>
}
class "StepStatus" as companion4soloplayer.core.creation.steps.base.StepStatus {
  +name
}
class "<color:red>WorkflowError</color>" as companion4soloplayer.core.creation.workflow.WorkflowError {
}
companion4soloplayer.core.creation.inputs.InvalidAnswerError --|> companion4soloplayer.core.creation.inputs.InputError
companion4soloplayer.core.creation.inputs.MissingInputError --|> companion4soloplayer.core.creation.inputs.InputError
companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.identity.IdentityStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.selection.SelectionStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.skills.SkillSelectionStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.steps.spells.SpellSelectionStep --|> companion4soloplayer.core.creation.steps.base.CreationStep
companion4soloplayer.core.creation.strategies.ConstantStrategy --|> companion4soloplayer.core.creation.strategies.AttributeGenerationStrategy
companion4soloplayer.core.creation.strategies.RollStrategy --|> companion4soloplayer.core.creation.strategies.AttributeGenerationStrategy
companion4soloplayer.core.creation.inputs.InputField --> companion4soloplayer.core.creation.inputs.InputKind : kind
companion4soloplayer.core.creation.rules.Effect --> companion4soloplayer.core.creation.rules.Action : action
companion4soloplayer.core.creation.rules.RulesEngine --> companion4soloplayer.core.creation.rules.CreationRule : _rules
companion4soloplayer.core.creation.rules.Condition --> companion4soloplayer.core.creation.rules.Operator : operator
companion4soloplayer.core.creation.steps.base.StepResult --> companion4soloplayer.core.creation.steps.base.StepStatus : status
companion4soloplayer.core.creation.rules.RulesEngine --* companion4soloplayer.core.creation.pipeline.CharacterCreationPipeline : _rules

' --- Force vertical alignment ---
companion4soloplayer.core.creation.rules.Action -[hidden]down-> companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep
companion4soloplayer.core.creation.steps.attributes.AttributeGenerationStep -[hidden]down-> companion4soloplayer.core.creation.strategies.AttributeGenerationStrategy
